# Clave de API de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini (opcional; gemini-2.0-flash ya no está disponible)
GEMINI_MODEL=gemini-2.5-flash

# Puerto del servidor (opcional)
PLANTIA_PORT=8000

# Defina um diretório exclusivo e persistente para SQLite e fotos.
# PLANET_DATA_DIR=/var/lib/planet-ia
# Origin HTTPS exata do ambiente, sem barra final.
# PLANET_PUBLIC_ORIGIN=https://homologacao.example.com
# Ativar apenas em desenvolvimento por HTTP na própria máquina.
# PLANET_INSECURE_LOCAL_HTTP=1

# Resend via HTTPS para verificação e recuperação. Use remetente autorizado.
PLANET_RESEND_API_KEY=
PLANET_RESEND_FROM=

# Stripe em homologação. Use chave sk_test_ ou rk_test_ e segredo do webhook de teste.
# Configure os identificadores dos preços recorrentes no painel administrativo do app.
PLANET_STRIPE_KEY=
PLANET_STRIPE_WEBHOOK_SECRET=
PLANET_STRIPE_PREMIUM_INTRO_COUPON=
# Stripe defaults to test. The legacy variables above are test-only fallbacks.
PLANET_STRIPE_MODE=test
PLANET_STRIPE_LIVE_ENABLED=0
# PLANET_STRIPE_TEST_KEY=
# PLANET_STRIPE_TEST_WEBHOOK_SECRET=
# PLANET_STRIPE_TEST_PREMIUM_INTRO_COUPON=
# PLANET_STRIPE_TEST_PORTAL_CONFIGURATION=
PLANET_STRIPE_LIVE_KEY=
PLANET_STRIPE_LIVE_WEBHOOK_SECRET=
PLANET_STRIPE_LIVE_PREMIUM_INTRO_COUPON=
PLANET_STRIPE_LIVE_PORTAL_CONFIGURATION=

# Apenas no ambiente isolado. Use 1 após configurar entrega de e-mail.
# PLANET_DEPLOYMENT=staging
# PLANET_REQUIRE_VERIFIED_EMAIL=1
# E-mail público da operação para solicitações de privacidade.
# PLANET_PRIVACY_CONTACT=

# Biblioteca GBIF em staging. O caminho padrão fica em PLANET_DATA_DIR.
# PLANET_BOTANICAL_INDEX=/data/botanical.sqlite
# PLANET_BOTANICAL_REFRESH_HOURS=168

# Enriquecimento botânico público habilitado por padrão.
# PLANET_BOTANICAL_ENRICHMENT=1
# Opcional em staging. Revalida o cache das cinco espécies prioritárias.
# PLANET_BOTANICAL_EVIDENCE_REFRESH_HOURS=168
